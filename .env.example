# Supabase public client values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase server values
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# AI grounding pipeline
TAVILY_API_KEY=tvly-your-api-key
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-5.6-terra

# Optional Render workspace automation
RENDER_AUTODEPLOY_WORKSPACES=false
RENDER_API_KEY=rnd_your-render-api-key
RENDER_OWNER_ID=tea-your-render-workspace-id
RENDER_DASHBOARD_REPO=https://github.com/your-org/paperloom.git
RENDER_DASHBOARD_BRANCH=main
RENDER_DASHBOARD_ROOT_DIR=
RENDER_DASHBOARD_BUILD_COMMAND=npm install && npm run build
RENDER_DASHBOARD_PUBLISH_PATH=out
RENDER_ENVIRONMENT_ID=
NEXT_OUTPUT_MODE=
